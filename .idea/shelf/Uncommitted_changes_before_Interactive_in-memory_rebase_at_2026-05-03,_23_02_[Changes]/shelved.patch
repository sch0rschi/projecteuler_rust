<+>use num_integer::Integer;\nuse num_traits::{FromPrimitive, PrimInt, Unsigned};\n\npub struct Primes<T> {\n    prime_sieve: Vec<bool>,\n    pub primes_list: Vec<T>,\n}\n\nimpl<T> Primes<T>\nwhere\n    T: PrimInt + Unsigned + FromPrimitive + Integer,\n{\n    pub fn primes_inclusive(limit: T) -> Self {\n        let limit_usize = limit.to_usize().expect(\"limit too large for sieve\");\n\n        let sieve = prime_sieve(limit_usize);\n\n        let list = sieve\n            .iter()\n            .enumerate()\n            .filter_map(|(i, &is_prime)| {\n                if is_prime {\n                    Some(T::from_usize(i).unwrap())\n                } else {\n                    None\n                }\n            })\n            .collect();\n\n        Primes {\n            prime_sieve: sieve,\n            primes_list: list,\n        }\n    }\n\n    pub fn unique_prime_factors(&self, mut n: T) -> Vec<T> {\n        let mut result = Vec::new();\n\n        if n < T::from_u8(2).unwrap() {\n            return result;\n        }\n\n        for &p in &self.primes_list {\n            if p * p > n {\n                break;\n            }\n\n            if n.is_multiple_of(&p) {\n                result.push(p);\n                while n.is_multiple_of(&p) {\n                    n = n / p;\n                }\n            }\n        }\n\n        if n > T::one() {\n            result.push(n);\n        }\n\n        result\n    }\n\n    pub fn prime_factors(&self, mut n: T) -> Vec<T> {\n        let mut result = Vec::new();\n\n        if n < T::from_u8(2).unwrap() {\n            return result;\n        }\n\n        for &p in &self.primes_list {\n            if n == T::one() {\n                break;\n            }\n\n            while n.is_multiple_of(&p) {\n                result.push(p);\n                n = n / p;\n            }\n        }\n\n        result\n    }\n\n    pub fn is_prime(&self, n: T) -> bool {\n        if let Some(idx) = n.to_usize()\n            && idx < self.prime_sieve.len()\n        {\n            return self.prime_sieve[idx];\n        }\n\n        if n < T::from_u8(2).unwrap() {\n            return false;\n        }\n\n        // fallback: simple deterministic test\n        let two = T::from_u8(2).unwrap();\n        let mut i = two;\n\n        while i * i <= n {\n            if n.is_multiple_of(&i) {\n                return false;\n            }\n            i = i + T::one();\n        }\n\n        true\n    }\n}\n\npub fn find_first_n_primes<T>(n: usize) -> Vec<T>\nwhere\n    T: PrimInt + Unsigned + FromPrimitive + Integer,\n{\n    let mut primes = vec![T::from_u8(2).unwrap(), T::from_u8(3).unwrap()];\n\n    for _ in 3..=n {\n        let next = find_next_prime(&primes);\n        primes.push(next);\n    }\n\n    primes\n}\n\nfn prime_sieve(limit: usize) -> Vec<bool> {\n    if limit < 2 {\n        return vec![false; limit + 1];\n    }\n\n    let mut sieve = vec![true; limit + 1];\n    sieve[0] = false;\n    sieve[1] = false;\n\n    let mut i = 2;\n    while i * i <= limit {\n        if sieve[i] {\n            let mut j = i * i;\n            while j <= limit {\n                sieve[j] = false;\n                j += i;\n            }\n        }\n        i += 1;\n    }\n\n    sieve\n}\n\nfn find_next_prime<T>(previous_primes: &[T]) -> T\nwhere\n    T: PrimInt + Unsigned + FromPrimitive + Integer,\n{\n    let two = T::from_u8(2).unwrap();\n    let mut candidate = *previous_primes.last().unwrap() + two;\n\n    loop {\n        let mut is_prime = true;\n\n        for &p in previous_primes {\n            if p * p > candidate {\n                break;\n            }\n            if candidate % p == T::zero() {\n                is_prime = false;\n                break;\n            }\n        }\n\n        if is_prime {\n            return candidate;\n        }\n\n        candidate = candidate + two;\n    }\n}\n\npub fn add_next_prime<T>(previous_primes: &mut Vec<T>)\nwhere\n    T: PrimInt + Unsigned + FromPrimitive + Integer,\n{\n    let next = find_next_prime(previous_primes);\n    previous_primes.push(next);\n}\n\npub fn unique_prime_factors<T>(mut n: T, primes: &[T]) -> Vec<T>\nwhere\n    T: PrimInt + Unsigned + FromPrimitive + Integer,\n{\n    let mut result = Vec::new();\n\n    for &p in primes {\n        if p * p > n {\n            break;\n        }\n\n        if n % p == T::zero() {\n            result.push(p);\n            while n % p == T::zero() {\n                n = n / p;\n            }\n        }\n    }\n\n    if n > T::one() {\n        result.push(n);\n    }\n\n    result\n}\n
